rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // A checkout-triggered stock decrement: only the `colors` field may
    // change, and (once a doc already has one) the array must keep the same
    // length (same color entries, same order) — this is what lets an
    // unauthenticated customer's order transaction deduct purchased
    // quantity from one color's size stock without granting them any other
    // write access to the product (price, name, images, other sizes'
    // labels, etc. stay admin-only).
    //
    // The `!hadColors ||` branch exists only for products that predate the
    // colors migration: their doc has no `colors` field yet, so there's no
    // prior length to compare against when the first purchase lazily
    // synthesizes one (see deriveProductColors() in lib/firebase/products.ts)
    // and writes it back for the first time.
    //
    // Firestore rules can't loop over a dynamic-length nested list to verify
    // "only one color's one size decreased, nothing else changed"
    // element-by-element, so this check is intentionally loose: a malicious
    // client could still send an arbitrary same-length `colors` array (e.g.
    // inflate a stock count, or change a nested size's label) as long as it
    // never touches any other top-level field. Tightening this further would
    // require a server-side Cloud Function running with elevated privileges
    // instead of a purely client-side transaction — out of scope for the
    // current architecture, called out here for future reference.
    function isValidColorsStockDecrement() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let hadColors = resource.data.keys().hasAny(['colors']);
      return affectedKeys.hasOnly(['colors']) &&
        request.resource.data.colors is list &&
        (!hadColors || request.resource.data.colors.size() == resource.data.colors.size());
    }

    // Products: publicly readable, only admins can create/delete/edit —
    // except a customer's checkout may decrement a color's size stock (see above).
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidColorsStockDecrement();
    }

    // Orders: anyone can place an order (create), but only admins can read
    // the order list/details or update order status. No public update/delete.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Contact messages: anyone can submit the form (create), but only
    // admins can read the inbox or mark a message as read. No public
    // update/delete.
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Admins: a signed-in user may read their own admin doc (used to check
    // role on login). No client-side writes — this collection is managed
    // manually from the Firebase Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Site settings (e.g. the homepage hero banner URL): publicly readable
    // so the storefront can render them, only admins can change them.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cart sessions: anonymous demand-insight tracking, keyed by a random
    // client-generated id (see lib/cartSession.ts) — never tied to auth, no
    // personal data ever written here (see syncCartSession() in
    // lib/firebase/cartSessions.ts). Any visitor may create/update their own
    // session doc as their cart changes, and delete it once it becomes a
    // real order (see checkout's success handler) or once they empty their
    // cart — but only admins can read the collection, so a customer can
    // never see another session's cart contents. There's no ownership check
    // on write (Firestore rules have no way to verify "this really is the
    // browser that created this id" without an auth token), but the id is
    // an unguessable UUID, and the collection holds nothing more sensitive
    // than "some anonymous cart has these line items" — not worth adding
    // auth to a feature specifically designed to stay anonymous.
    match /cartSessions/{sessionId} {
      allow create, update, delete: if true;
      allow read: if isAdmin();
    }

    // Order submissions: idempotency tracking for placeOrder() (see
    // lib/checkoutIdempotency.ts and lib/firebase/orders.ts) — maps a
    // client-generated retry key to the order id it produced, so a
    // retried checkout (after a dropped response that hid a real success)
    // can detect "this already went through" and skip re-decrementing
    // stock / placing a duplicate order. Holds nothing but that mapping —
    // no customer data — so unlike `orders` (admin-only read), it's safe
    // for anyone to read: an anonymous transaction.get() needs to check a
    // key it's about to write before writing it, and the only thing a
    // reader could learn is "this random id maps to this order id", which
    // reveals nothing since `orders` itself stays unreadable to them.
    // Never updated after creation (the same key always maps to the same
    // order) and never deleted (harmless small documents, and there's no
    // safe way to know a given key will never be retried again).
    match /orderSubmissions/{key} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Order errors: a diagnostic log of failed checkout attempts (see
    // lib/firebase/orderErrors.ts) — same access pattern as
    // `contactMessages`/`orders`: anyone can write their own failure
    // report, only admins can read the log (it holds the same customer
    // contact fields `orders` does, needed to trace a vague support report
    // back to what actually happened).
    match /orderErrors/{errorId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
