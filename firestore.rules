rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // A checkout-triggered stock decrement: only the `sizes` field may
    // change, and the array must keep the same length (same size entries,
    // same order) — this is what lets an unauthenticated customer's order
    // transaction deduct purchased quantity from one size's stock without
    // granting them any other write access to the product (price, name,
    // images, other sizes' labels, etc. stay admin-only).
    //
    // Firestore rules can't loop over a dynamic-length list to verify "only
    // one entry's stock decreased, nothing else changed" element-by-element,
    // so this check is intentionally looser than the old single-`stock`
    // rule: a malicious client could still send an arbitrary same-length
    // `sizes` array (e.g. inflate a stock count) as long as it never touches
    // any other top-level field. Tightening this further would require a
    // server-side Cloud Function running with elevated privileges instead of
    // a purely client-side transaction — out of scope for the current
    // architecture, called out here for future reference.
    function isValidSizesStockDecrement() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['sizes']) &&
        request.resource.data.sizes is list &&
        request.resource.data.sizes.size() == resource.data.sizes.size();
    }

    // Products: publicly readable, only admins can create/delete/edit —
    // except a customer's checkout may decrement a size's stock (see above).
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidSizesStockDecrement();
    }

    // Orders: anyone can place an order (create), but only admins can read
    // the order list/details or update order status. No public update/delete.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Contact messages: anyone can submit the form (create), but only
    // admins can read the inbox or mark a message as read. No public
    // update/delete.
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Admins: a signed-in user may read their own admin doc (used to check
    // role on login). No client-side writes — this collection is managed
    // manually from the Firebase Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
