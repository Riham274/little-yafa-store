# Firebase project config — from Firebase Console > Project Settings > General
# > "Your apps" > Web app > SDK setup and configuration ("Config" option).
# If no Web app exists yet in your Firebase project, create one there first
# (this only registers a web client; it does NOT affect your existing
# Firestore/Auth/Storage setup or the existing admin account).

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCtKKuDQbt8sPot4eMkQ--MznVvHvFiBtQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=little-yafa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=little-yafa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=little-yafa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=580284737831
NEXT_PUBLIC_FIREBASE_APP_ID=1:580284737831:web:13237cfbd8cecccab8e102

# Google Cloud Translation API key — from Google Cloud Console > APIs &
# Services > Credentials, on the same Firebase/GCP project, with the Cloud
# Translation API enabled. Server-side only (no NEXT_PUBLIC_ prefix) — used
# by app/api/translate to auto-translate admin product fields from Arabic
# into English and Hebrew, and is never sent to the browser.
GOOGLE_TRANSLATE_API_KEY=your-translate-api-key-here